#!/usr/bin/env php
<?php

/*
 * Update Version Composer
 */

defined( "BASE_DIR" ) || define(
  "BASE_DIR", realpath( 
    __DIR__ . "/../../../../"
  ) . DIRECTORY_SEPARATOR
);

file_put_contents(
  BASE_DIR . ".env",
  implode(
    PHP_EOL, [
      "# connect",
      "TYPE=sqlserver",
      "HOST=",
      "PORT=",
      "NAME=",
      "USER=",
      "PASS=",
      "",
      "# api",
      "API_PORT=3000",
      "API_VERSION=1",
      "API_MAX_REQUESTS=1500",
      "API_KEEP_ALIVE_TIME_OUT=30",
      "API_IS_WORKER=true"
    ]
  )
);